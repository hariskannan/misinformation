# TruthGuard backend - environment template
# Copy to .env and fill in real values. Never commit the filled .env file.

DJANGO_SECRET_KEY=generate-a-long-random-secret-here
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.com

# Primary database: PostgreSQL
USE_SQLITE=0
DB_NAME=truthguard
DB_USER=truthguard
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Allowed CORS origins for the React frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TruthGuard risk policy
TG_HIGH_RISK_THRESHOLD=0.75
TG_MEDIUM_RISK_ACTION=publish
